# ~/.secrets template
#
# This file is sourced by ~/.zshrc (see the `source ~/.secrets` line).
# Only variable NAMES live here — real values are NEVER committed.
#
# On a new machine, install.sh copies this to ~/.secrets and chmod 600s it.
# Then fill in the real values below.
#
# Manual setup (if not using install.sh):
#   1. cp secrets.example ~/.secrets
#   2. Fill in the real values below
#   3. chmod 600 ~/.secrets

# Vast Anthropic proxy — DEV (used by Neovim parrot.nvim, opencode, etc.)
export VAST_ANTHROPIC_DEV_BASE_URL=""
export VAST_ANTHROPIC_DEV_TOKEN=""

# Vast Anthropic proxy — PRD
export VAST_ANTHROPIC_PRD_BASE_URL=""
export VAST_ANTHROPIC_PRD_TOKEN=""

# Vast internal PyPI index credentials (used by uv)
export UV_INDEX_VAST_PYPY_USERNAME=""
export UV_INDEX_VAST_PYPY_PASSWORD=""
