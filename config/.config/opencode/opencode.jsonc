        "bedrock/arn:aws-us-gov:bedrock:us-gov-west-1:312069862701:inference-profile/us-gov.anthropic.claude-sonnet-4-5-20250929-v1:0": {
          "name": "bedrock/arn:aws-us-gov:bedrock:us-gov-west-1:312069862701:inference-profile/us-gov.anthropic.claude-sonnet-4-5-20250929-v1:0 (Dev)",
