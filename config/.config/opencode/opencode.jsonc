{
  "$schema": "https://opencode.ai/config.json",
  "compaction": {
    "auto": true,
    "prune": true
  },
  "policies": [
    { "action": "tool.use", "resource": "read:*/.secrets", "effect": "deny" },
    { "action": "tool.use", "resource": "edit:*/.secrets", "effect": "deny" },
    { "action": "tool.use", "resource": "read:*/.secrets/*", "effect": "deny" },
    { "action": "tool.use", "resource": "edit:*/.secrets/*", "effect": "deny" },
    { "action": "tool.use", "resource": "read:*/.ssh/*", "effect": "deny" },
    { "action": "tool.use", "resource": "edit:*/.ssh/*", "effect": "deny" },
    { "action": "tool.use", "resource": "read:*/.config/gh/hosts.yml", "effect": "deny" },
    { "action": "tool.use", "resource": "edit:*/.config/gh/hosts.yml", "effect": "deny" },
    { "action": "tool.use", "resource": "read:*/.config/gh.bak/hosts.yml", "effect": "deny" },
    { "action": "tool.use", "resource": "edit:*/.config/gh.bak/hosts.yml", "effect": "deny" },
    { "action": "tool.use", "resource": "read:*/.config/opencode/service.json", "effect": "deny" },
    { "action": "tool.use", "resource": "edit:*/.config/opencode/service.json", "effect": "deny" },
    { "action": "tool.use", "resource": "read:*/.config/opencode.bak/service.json", "effect": "deny" },
    { "action": "tool.use", "resource": "edit:*/.config/opencode.bak/service.json", "effect": "deny" },
    { "action": "tool.use", "resource": "read:*/.local/state/opencode/*", "effect": "deny" },
    { "action": "tool.use", "resource": "edit:*/.local/state/opencode/*", "effect": "deny" },
    { "action": "tool.use", "resource": "read:*/.local/share/opencode/opencode.db*", "effect": "deny" },
    { "action": "tool.use", "resource": "edit:*/.local/share/opencode/opencode.db*", "effect": "deny" },
    { "action": "tool.use", "resource": "read:*/.local/share/opencode/auth.json", "effect": "deny" },
    { "action": "tool.use", "resource": "edit:*/.local/share/opencode/auth.json", "effect": "deny" },
    { "action": "tool.use", "resource": "shell:*opencode auth export*", "effect": "deny" }
  ],
  "mcp": {
    "svelte": {
      "type": "local",
      "command": [
        "npx",
        "-y",
        "@sveltejs/mcp"
      ],
      "enabled": false
    },
    "chrome-devtools": {
      "type": "local",
      "command": [
        "npx",
        "-y",
        "chrome-devtools-mcp@latest",
        "--headless=true",
        "--isolated=true",
        "--no-usage-statistics",
        "--no-performance-crux"
      ],
      "enabled": false
    },
    "open-pencil": {
      "type": "local",
      "command": [
        "openpencil-mcp"
      ],
      "enabled": false
    }
  },
  "plugin": [
    "@nick-vi/opencode-type-inject",
    "@tarquinen/opencode-dcp@latest"
  ],
  "lsp": {
    "basedpyright": {
      "command": [
        "basedpyright-langserver",
        "--stdio"
      ],
      "extensions": [
        ".py",
        ".pyi"
      ],
      "initialization": {
        "python": {
          "analysis": {
            "autoSearchPaths": true,
            "useLibraryCodeForTypes": true,
            "diagnosticMode": "workspace",
            "typeCheckingMode": "basic"
          }
        }
      }
    },
    "pyright": {
      "disabled": true
    }
  },
  "provider": {
    "litellm": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "LiteLLM (OpenAI)",
      "options": {
        "baseURL": "{env:LITELLM_BASE_URL}"
      },
      "models": {
        "chatgpt/gpt-5.6-luna": { "name": "GPT-5.6 Luna (LiteLLM)" },
        "chatgpt/gpt-5.6-sol": { "name": "GPT-5.6 Sol (LiteLLM)" },
        "chatgpt/gpt-5.6-terra": { "name": "GPT-5.6 Terra (LiteLLM)" },
        "chatgpt/gpt-6-astra": { "name": "GPT-6 Astra (LiteLLM)" },
        "chatgpt/gpt-6-luna": { "name": "GPT-6 Luna (LiteLLM)" },
        "chatgpt/gpt-6-sol": { "name": "GPT-6 Sol (LiteLLM)" },
        "chatgpt/gpt-6.1-sol": { "name": "GPT-6.1 Sol (LiteLLM)" },
        "chatgpt/gpt-6.1-terra": { "name": "GPT-6.1 Terra (LiteLLM)" },
        "chatgpt/gpt-6.2-astra": { "name": "GPT-6.2 Astra (LiteLLM)" },
        "chatgpt/gpt-6.2-sol": { "name": "GPT-6.2 Sol (LiteLLM)" },
        "chatgpt/gpt-daybreak-blue-latest": { "name": "GPT Daybreak Blue (LiteLLM)" },
        "chatgpt/gpt-daybreak-red-latest": { "name": "GPT Daybreak Red (LiteLLM)" }
      }
    }
  },
  "model": "litellm/chatgpt/gpt-6-astra"
}
