{
  "$schema": "https://opencode.ai/config.json",
  "compaction": {
    "auto": true,
    "prune": true
  },
  "mcp": {
    "mcp-atlassian": {
      "type": "local",
      "command": ["uvx", "mcp-atlassian"],
      "environment": {
        "JIRA_URL": "https://jira.int.vastspace.com/",
        "JIRA_PERSONAL_TOKEN": "",
        "CONFLUENCE_URL": "https://confluence.int.vastspace.com/",
        "CONFLUENCE_PERSONAL_TOKEN": ""
      }
    },
    // Manufacturo production database
    "manufacturo": {
      "type": "local",
      "command": [
        "node",
        "/Users/oskar/.config/opencode/node_modules/@mcp-collection/mssql-mcp/build/index.js"
      ],
      "environment": {
        "HOST": "{env:MANUFACTURO_HOST}",
        "PORT": "{env:MANUFACTURO_PORT}",
        "DATABASE": "{env:MANUFACTURO_DATABASE}",
        "USER": "{env:MANUFACTURO_USER}",
        "PASSWORD": "{env:MANUFACTURO_PASSWORD}",
        "ENCRYPT": "true",
        "TRUST_SERVER_CERTIFICATE": "true"
      },
      "enabled": false
    },
    "jira": {
      "type": "remote",
      "url": "http://k8s-mcp-atlassia-7f809f50ea-333145e7ddf401ff.elb.us-gov-west-1.amazonaws.com/mcp",
      "headers": {
        "Authorization": "Bearer "
      },
      "enabled": false
    },
    "github": {
      "type": "remote",
      "url": "http://k8s-mcp-githubmc-441c0c5c50-b427b1b197cb1205.elb.us-gov-west-1.amazonaws.com/mcp",
      "headers": {
        "Authorization": "Bearer "
      },
      "enabled": false
    },
    // Manufacturo online database (remote MCP server)
    "manufacturo-online": {
      "type": "remote",
      "url": "http://k8s-mcp-manufact-4228bbbbb6-790864163527aede.elb.us-gov-west-1.amazonaws.com/mcp",
      "headers": {
        "Authorization": "Bearer "
      },
      "enabled": false
    },
    // Pulse Aurora PostgreSQL database (staging, read-only replica)
    "pulse-stg": {
      "type": "local",
      "command": [
        "bash",
        "-c",
        "export PGPASSWORD=$(/Users/oskar/bin/tableplus-pulse-stg.sh) && export NODE_TLS_REJECT_UNAUTHORIZED=0 && export PGSSLMODE=require && npx -y @neverinfamous/postgres-mcp --host pulse-aurora-cluster-stg.cluster-ro-c52b8zovxku7.us-gov-west-1.rds.amazonaws.com --database pulse_db --user db_admin --pg-port 5432"
      ],
      "enabled": false
    },
    // NetSuite JDBC MCP - Query NetSuite database via JDBC
    "netsuite": {
      "type": "local",
      "command": [
        "java",
        "-Djdbc.url={env:NETSUITE_JDBC_URL}",
        "-Djdbc.user={env:NETSUITE_JDBC_USER}",
        "-Djdbc.password={env:NETSUITE_JDBC_PASSWORD}",
        "-cp",
        "/Users/nik.lubyanoy/.config/opencode/tools/mcp-jdbc-server/MCPServer-1.0.0-runner.jar:/Users/nik.lubyanoy/.config/opencode/tools/java_libs/NQjc.jar:/Users/nik.lubyanoy/.config/opencode/tools/java_libs/json.jar",
        "io.quarkus.runner.GeneratedMain"
      ],
      "enabled": false
    },
    // Chrome DevTools MCP - Browser automation and debugging
    "chrome-devtools": {
      "type": "local",
      "command": [
        "npx",
        "-y",
        "chrome-devtools-mcp@latest",
        "--headless=true",
        "--isolated=true",
        "--no-usage-statistics",
        "--no-performance-crux"
      ],
      "enabled": false
    },
    // OpenPencil MCP - Read and modify Figma .fig files headlessly
    "open-pencil": {
      "type": "local",
      "command": ["openpencil-mcp"],
      "enabled": false
    },
    "teamcenter": {
      "type": "remote",
      "url": "http://k8s-mcp-teamcent-e3e098db2f-b8ced4b2682478b1.elb.us-gov-west-1.amazonaws.com/mcp",
      "headers": {
        "Authorization": "Bearer  "
      },
      "enabled": false
    },
    // QuickBooks Online MCP Server
    "quickbooks-online": {
      "type": "local",
      "command": [
        "node",
        "/Users/Oskar/Programming/_LOCAL/quickbooks/quickbooks-online-mcp-server/dist/index.js"
      ],
      "enabled": false
    },
    "svelte": {
      "type": "local",
      "command": ["npx", "-y", "@sveltejs/mcp"]
    },
    // Google Drive MCP with OAuth 2.0 authentication
    "google-drive": {
      "type": "remote",
      "url": "https://localhost:8001/mcp",
      "enabled": true
    },
    // Google Drive MCP (Dev)
    "google-drive-dev": {
      "type": "remote",
      "url": "https://googledrive-mcp-dev.int.vastspace.com/mcp",
      "enabled": false
    },
    "google-drive-local": {
      "type": "remote",
      "url": "https://localhost:8001/mcp",
      "enabled": false
    },
    // Smartsheet MCP with OAuth 2.0 authentication
    "smartsheet": {
      "type": "remote",
      "url": "https://localhost:8002/mcp",
      "enabled": true
    }
  },
  "plugin": [
    "@nick-vi/opencode-type-inject",
    "opencode-openai-codex-auth",
    "@tarquinen/opencode-dcp@latest"
  ],
  "lsp": {
    "basedpyright": {
      "command": ["basedpyright-langserver", "--stdio"],
      "extensions": [".py", ".pyi"],
      "initialization": {
        "python": {
          "analysis": {
            "autoSearchPaths": true,
            "useLibraryCodeForTypes": true,
            "diagnosticMode": "workspace",
            "typeCheckingMode": "basic"
          }
        }
      }
    },
    "pyright": {
      "disabled": true
    }
  },
  "provider": {
    "vast-dev": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "Vast Bedrock Proxy (Dev)",
      "options": {
        "baseURL": "{env:VAST_ANTHROPIC_DEV_BASE_URL}",
        "headers": {
          "Authorization": "Bearer {env:VAST_ANTHROPIC_DEV_TOKEN}"
        }
      },
      "models": {
        "vertex_ai/claude-opus-4-6": {
          "name": "vertex_ai/claude-opus-4-6"
        },
        "vertex_ai/claude-opus-4-8": {
          "name": "vertex_ai/claude-opus-4-8"
        },
        "anthropic.claude-3-7-sonnet-20250219-v1:0": {
          "name": "anthropic.claude-3-7-sonnet-20250219-v1:0",
          "contextWindow": 200000,
          "maxOutputTokens": 8192,
          "pricing": {
            "input": 0.000003,
            "output": 0.000015,
            "cacheCreation": 0.00000375,
            "cacheRead": 3e-7
          },
          "capabilities": {
            "vision": true,
            "functionCalling": true,
            "toolChoice": true,
            "responseSchema": true,
            "assistantPrefill": true,
            "promptCaching": true,
            "pdfInput": true,
            "reasoning": true,
            "computerUse": true
          },
          "provider": {
            "litellm": "bedrock_converse",
            "awsRegion": "us-gov-west-1"
          },
          "supportedParams": [
            "max_tokens",
            "max_completion_tokens",
            "stream",
            "stream_options",
            "stop",
            "temperature",
            "top_p",
            "extra_headers",
