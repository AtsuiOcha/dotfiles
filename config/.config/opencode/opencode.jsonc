{
  "$schema": "https://opencode.ai/config.json",
  "compaction": {
    "auto": true,
    "prune": true
  },
  "mcp": {
    // mcp-farm-poc (~/dev/mcp-farm-poc) stg servers. OAuth via Authentik (slack/google via upstream).
    // Run `opencode mcp auth <name>` once per server; tokens refresh automatically.
    "jira-stg": {
      "type": "remote",
      "url": "https://ji-4a1fb0276a904dc085969e01a7843a00.ecs.us-gov-west-1.on.aws/mcp",
      "enabled": true,
      "timeout": 30000
    },
    "confluence-stg": {
      "type": "remote",
      "url": "https://co-3ffe6e895ce94bb19122eb646a257585.ecs.us-gov-west-1.on.aws/mcp",
      "enabled": true,
      "timeout": 30000
    },
    "slack-stg": {
      "type": "remote",
      "url": "https://sl-55fcfb4bda404620bb4d5951f0fd1cad.ecs.us-gov-west-1.on.aws/mcp",
      "enabled": true,
      "timeout": 30000
    },
    "google-workspace-stg": {
      "type": "remote",
      "url": "https://go-710d6af969154737ac89fda3aede0cd7.ecs.us-gov-west-1.on.aws/mcp",
      "enabled": true,
      "timeout": 30000
    },
    "manufacturo-stg": {
      "type": "remote",
      "url": "https://ma-98887933560a4354bbed80b3dee0916e.ecs.us-gov-west-1.on.aws/mcp",
      "enabled": true,
      "timeout": 30000
    },
    "netsuite-stg": {
      "type": "remote",
      "url": "https://ne-3ade4331a4a14d14a4be958c00224e1b.ecs.us-gov-west-1.on.aws/mcp",
      "enabled": true,
      "timeout": 30000
    },
    "teamcenter-stg": {
      "type": "remote",
      "url": "https://te-352193e5a74346998de70e296c3b474c.ecs.us-gov-west-1.on.aws/mcp",
      "enabled": true,
      "timeout": 30000
    },
    "plane-stg": {
      "type": "remote",
      "url": "https://pl-4944cf1f39184331bafee1f75d2619f2.ecs.us-gov-west-1.on.aws/mcp",
      "enabled": false,
      "timeout": 30000
    },
    // Plane with Oskar's personal access token (PLANE_TOKEN in ~/.secrets). Pinned to 0.2.9 for Plane 2.6.5.
    "plane-oskar": {
      "type": "local",
      "command": ["uvx", "plane-mcp-server==0.2.9", "stdio"],
      "environment": {
        "PLANE_API_KEY": "{env:PLANE_TOKEN}",
        "PLANE_WORKSPACE_SLUG": "vast",
        "PLANE_BASE_URL": "https://plane.int.vastspace.com"
      },
      "enabled": true,
      "timeout": 30000
    },
    "svelte": {
      "type": "local",
      "command": [
        "npx",
        "-y",
        "@sveltejs/mcp"
      ]
    },
    "pulse-stg": {
      "type": "local",
      "command": [
        "bash",
        "-c",
        "export PGPASSWORD=$(/Users/oskar/bin/tableplus-pulse-stg.sh) && export NODE_TLS_REJECT_UNAUTHORIZED=0 && export PGSSLMODE=require && npx -y @neverinfamous/postgres-mcp --host pulse-aurora-cluster-stg.cluster-ro-c52b8zovxku7.us-gov-west-1.rds.amazonaws.com --database pulse_db --user db_admin --pg-port 5432"
      ],
      "enabled": false
    },
    "chrome-devtools": {
      "type": "local",
      "command": [
        "npx",
        "-y",
        "chrome-devtools-mcp@latest",
        "--headless=true",
        "--isolated=true",
        "--no-usage-statistics",
        "--no-performance-crux"
      ],
      "enabled": false
    },
    "open-pencil": {
      "type": "local",
      "command": [
        "openpencil-mcp"
      ],
      "enabled": false
    },
    "quickbooks-online": {
      "type": "local",
      "command": [
        "node",
        "/Users/Oskar/Programming/_LOCAL/quickbooks/quickbooks-online-mcp-server/dist/index.js"
      ],
      "enabled": false
    }
  },
  "plugin": [
    "@nick-vi/opencode-type-inject",
    "opencode-openai-codex-auth",
    "@tarquinen/opencode-dcp@latest"
  ],
  "lsp": {
    "basedpyright": {
      "command": [
        "basedpyright-langserver",
        "--stdio"
      ],
      "extensions": [
        ".py",
        ".pyi"
      ],
      "initialization": {
        "python": {
          "analysis": {
            "autoSearchPaths": true,
            "useLibraryCodeForTypes": true,
            "diagnosticMode": "workspace",
            "typeCheckingMode": "basic"
          }
        }
      }
    },
    "pyright": {
      "disabled": true
    }
  },
  "provider": {
    "vast-dev": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "Vast Bedrock Proxy (Dev)",
      "options": {
        "baseURL": "{env:VAST_ANTHROPIC_DEV_BASE_URL}",
        "headers": {
          "Authorization": "Bearer {env:VAST_ANTHROPIC_DEV_TOKEN}"
        }
      },
      "models": {
        "anthropic.claude-3-7-sonnet-20250219-v1:0": {
          "name": "anthropic.claude-3-7-sonnet-20250219-v1:0 (Dev)",
          "environment": "dev"
        },
        "anthropic.claude-3-haiku-20240307-v1:0": {
