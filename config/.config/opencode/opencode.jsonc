        },
        "us-gov.anthropic.claude-opus-5-5": {
          "name": "opus-5-5 (Dev)",
          "environment": "dev"
        }
      }
    },
    "vast-prod": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "Vast Bedrock Proxy (Prod)",
      "options": {
        "baseURL": "{env:VAST_ANTHROPIC_PRD_BASE_URL}",
        "headers": {
          "Authorization": "Bearer {env:VAST_ANTHROPIC_PRD_TOKEN}"
