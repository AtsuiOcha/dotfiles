# Secrets — never commit
.secrets
secrets

# AWS — real config (contains account IDs / SSO org details), never commit
aws/config
.aws/

# macOS cruft
.DS_Store
**/.DS_Store

# Google Drive upload temp
.tmp.driveupload/

# Local, machine-specific tmux project definitions (real project paths)
tmux/.tmux/projects.local.yaml

# OpenCode runtime-generated files (machine-local)
config/.config/opencode/cli.json
config/.config/opencode/service.json

# tmux plugin manager clones plugins here at install time
tmux/.tmux/plugins/
.tmux/plugins/

# Neovim runtime/state (only config is tracked, not installed plugins/state)
nvim/lazy-lock.local.json
nvim/.luarc.json
nvim/spell/
nvim/tags
