# Secrets — never commit
.secrets
secrets

# macOS cruft
.DS_Store
**/.DS_Store

# Google Drive upload temp
.tmp.driveupload/

# Local, machine-specific tmux project definitions (real project paths)
tmux/.tmux/projects.local.yaml

# tmux plugin manager clones plugins here at install time
tmux/.tmux/plugins/
.tmux/plugins/

# Neovim runtime/state (only config is tracked, not installed plugins/state)
nvim/lazy-lock.local.json
nvim/.luarc.json
nvim/spell/
nvim/tags
